<header class="sticky top-0 z-50 bg-white/60 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-2 pb-0">
    <div class="flex items-center justify-between">

      <!-- Logo -->
      <a href="/" class="flex items-center">
        <%- include("../icons/horizontal-logo") %>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-8 text-sm font-medium text-slate-600">
        <a href="#how-it-works" class="hover:text-brand-orange transition">How it works</a>
        <a href="#oauth-flow" class="hover:text-brand-orange transition">OAuth 2.0 flow</a>
        <a href="#features" class="hover:text-brand-orange transition">Why Pramaan</a>
        <a href="<%= docUrl %>" class="hover:text-brand-orange transition">Docs</a>
      </nav>

      <!-- Desktop Auth Buttons -->
      <div class="hidden lg:flex items-center gap-3">
        <a href="/signin" class="text-sm font-medium px-4 py-2 rounded-lg text-slate-600 hover:text-brand-orange transition">
          Sign in
        </a>
        <a href="/signup" class="px-5 py-2.5 text-sm btn-orange">
          Get Started
        </a>
      </div>

      <!-- Mobile Hamburger -->
      <button id="menuBtn" class="lg:hidden inline-flex items-center justify-center p-2 rounded-md text-slate-700 hover:bg-slate-100 transition">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobileMenu" class="hidden lg:hidden bg-transparent mt-2 backdrop-blur-xs">
    <div class="p-3 mx-2 roundedd-xl flex flex-col gap-1 text-sm font-medium text-slate-700">

      <a href="#how-it-works" class="hover:text-brand-orange font-mono transition">How it works</a>
      <a href="#oauth-flow" class="hover:text-brand-orange font-mono transition">OAuth 2.0 flow</a>
      <a href="#features" class="hover:text-brand-orange font-mono transition">Why Pramaan</a>
      <a href="<%= docUrl %>" class="hover:text-brand-orange font-mono transition">Docs</a>

      <div class="pt-2 flex flex-col gap-3">
        <a href="/signin" class="px-4 py-2 btn-orange">
          Sign in
        </a>
      </div>

    </div>
  </div>
</header>