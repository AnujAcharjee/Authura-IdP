<%
  const _id = typeof id !== 'undefined' ? id : null;
  const _name = typeof name !== 'undefined' ? name : null;
  const _label = typeof label !== 'undefined' ? label : null;
  const _type = typeof type !== 'undefined' ? type : 'text';
  const _required = typeof required !== 'undefined' ? required : false;
  const _autocomplete = typeof autocomplete !== 'undefined' ? autocomplete : null;
  const _placeholder = typeof placeholder !== 'undefined' ? placeholder : null;
  const _value = typeof value !== 'undefined' ? value : null;
  const _disabled = typeof disabled !== 'undefined' ? disabled : false;
  const _helperText = typeof helperText !== 'undefined' ? helperText : null;
  const _minlength = typeof minlength !== 'undefined' ? minlength : null;
  const _maxlength = typeof maxlength !== 'undefined' ? maxlength : null;
  const _pattern = typeof pattern !== 'undefined' ? pattern : null;
%>

<div class="space-y-2">
  <% if (_label && _id) { %>
    <label for="<%= _id %>" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 ml-0.5">
      <%= _label %>
      <% if (_required) { %>
        <span class="text-brand-orangeDark">*</span>
      <% } %>
    </label>
  <% } %>

  <div class="relative">
    <input
      <% if (_id) { %>id="<%= _id %>"<% } %>
      <% if (_name) { %>name="<%= _name %>"<% } %>
      type="<%= _type %>"
      <% if (_required) { %>required<% } %>
      <% if (_autocomplete) { %>autocomplete="<%= _autocomplete %>"<% } %>
      <% if (_placeholder) { %>placeholder="<%= _placeholder %>"<% } %>
      <% if (_value) { %>value="<%= _value %>"<% } %>
      <% if (_disabled) { %>disabled<% } %>
      <% if (_minlength) { %>minlength="<%= _minlength %>"<% } %>
      <% if (_maxlength) { %>maxlength="<%= _maxlength %>"<% } %>
      <% if (_pattern) { %>pattern="<%= _pattern %>"<% } %>
      class="input-field <%= _type === 'password' ? 'pr-11' : '' %>"
    />

    <% if (_type === 'password' && _id) { %>
      <button
        type="button"
        data-password-target="<%= _id %>"
        class="password-toggle-btn absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 transition-all p-1 cursor-pointer focus:outline-none active:scale-90 select-none"
        aria-label="Toggle password visibility"
      >
        <!-- Eye Icon (Show) -->
        <svg class="w-5 h-5 show-icon pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <!-- Eye-Off Icon (Hide) -->
        <svg class="w-5 h-5 hide-icon hidden pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
        </svg>
      </button>
    <% } %>
  </div>

  <% if (_helperText) { %>
    <p class="text-xs text-slate-405 dark:text-slate-500 ml-0.5"><%= _helperText %></p>
  <% } %>
</div>