<%
  const _id = typeof id !== 'undefined' ? id : null;
  const _name = typeof name !== 'undefined' ? name : null;
  const _label = typeof label !== 'undefined' ? label : null;
  const _required = typeof required !== 'undefined' ? required : false;
  const _options = typeof options !== 'undefined' ? options : [];
  const _helperText = typeof helperText !== 'undefined' ? helperText : null;
  const _value = typeof value !== 'undefined' ? value : null;
%>

<div class="space-y-2">
  <% if (_label && _id) { %>
    <label for="<%= _id %>" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 ml-0.5">
      <%= _label %>
      <% if (_required) { %>
        <span class="text-brand-orangeDark">*</span>
      <% } %>
    </label>
  <% } %>

  <select
    <% if (_id) { %>id="<%= _id %>"<% } %>
    <% if (_name) { %>name="<%= _name %>"<% } %>
    <% if (_required) { %>required<% } %>
    class="input-field cursor-pointer"
  >
    <% _options.forEach(function(option) { %>
      <option value="<%= option.value %>" <%= _value === option.value ? 'selected' : '' %> class="dark:bg-slate-900 dark:text-slate-100">
        <%= option.label %>
      </option>
    <% }); %>
  </select>

  <% if (_helperText) { %>
    <p class="text-xs text-slate-405 dark:text-slate-500 ml-0.5"><%= _helperText %></p>
  <% } %>
</div>