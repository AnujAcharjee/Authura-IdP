      <a href="/account" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 hover:text-brand-orange transition-colors">
        Dashboard
      </a>

      <a href="/docs" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 hover:text-brand-orange transition-colors">
