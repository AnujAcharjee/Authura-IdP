<nav class="sticky top-0 z-50 bg-white/70 dark:bg-[#0b0d18]/80 backdrop-blur-xl border-b border-slate-200/40 dark:border-slate-800/40 shadow-xs dark:shadow-black/10 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center hover:opacity-90 transition-opacity">
        <%- include("./icons/horizontal-logo") %>
