      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        <a href="/account" class="text-sm font-semibold text-slate-600 dark:text-slate-350 hover:text-brand-orange dark:hover:text-brand-orange transition-all duration-300">
