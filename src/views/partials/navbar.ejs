        <a href="/signin" class="text-sm font-semibold text-slate-600 dark:text-slate-350 hover:text-brand-orange transition-colors">
          Sign in
        </a>
        <a href="/signup" class="btn-orange !px-5 !py-2.5 !text-sm">
