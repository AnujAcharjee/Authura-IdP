        <div class="flex items-center gap-3">
          <%- include("./user-menu", { user }) %>
        </div>
        <% } else { %>
        <a href="/signin" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 hover:text-brand-orange transition-colors mb-4">
          Sign in
        </a>

        <a href="/signup" class="block text-center px-4 py-2.5 rounded-xl bg-linear-to-r from-brand-orange to-brand-orangeDark text-white text-sm font-bold shadow-md hover:shadow-lg transition-all duration-300">
          Get Started
        </a>
        <% } %>
      </div>

    </div>
