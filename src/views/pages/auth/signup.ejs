<% layout("layouts/main") %>

<% 
  const _flow = flow ?? 'default';
%>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-12 px-4 relative z-10 animate-slideIn">
  <div class="w-full max-w-md">
    <!-- Main Card -->
    <div class="glass-card p-8 sm:p-10 hover:shadow-orange-500/5 hover:border-brand-orange/20 transition-all duration-500">

      <%- include("../../partials/form/header", {
        title: "Create account",
        subtitle: "Get started with Pramaan. Create your secure identity."
      }) %>

      <%- include("../../partials/alert", {success, error}) %>

      <% if (success === "Sign-in verification email has been sent to the registered email address") { %>
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700/30 bg-slate-50/50 dark:bg-[#1a1e28]/50 p-4 text-sm text-slate-900 dark:text-slate-300 shadow-xs">
        Check your email for the email verification link to complete sign up.
      </div>
      <% } else { %>
      <form method="POST" action="/signup" class="space-y-6">

        <input type="hidden" name="flow" value="<%= _flow %>" />

        <% if (_flow === 'oauth') { %>
        <input type="hidden" name="request_id" value="<%= requestId %>" />
        <% } %>

        <%- include("../../partials/form/input", {
          id: "email",
          name: "email",
          type: "email",
          label: "Email address",
          required: true,
          autocomplete: "email",
          placeholder: "you@example.com"
        }) %>

        <%- include("../../partials/form/input", {
          id: "name",
          name: "name",
          type: "text",
          label: "Full name",
          required: true,
          autocomplete: "name",
          placeholder: "John Doe"
        }) %>

        <%- include("../../partials/form/select", {
          id: "gender",
          name: "gender",
          label: "Gender",
          required: true,
          options: [
            { value: "MALE", label: "Male" },
            { value: "FEMALE", label: "Female" },
            { value: "OTHER", label: "Other" }
          ]
        }) %>

        <%- include("../../partials/form/input", {
          id: "password",
          name: "password",
          type: "password",
          label: "Password",
          required: true,
          autocomplete: "new-password",
          placeholder: "••••••••",
          minlength: 8,
          maxlength: 100,
          pattern: '^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&])[A-Za-z\\d@$!%*?&]{8,100}$',
          helperText: "Must be at least 8 characters, with upper and lower case, a number, and a special character"
        }) %>

        <%- include("../../partials/form/input", {
          id: "confirmPassword",
          name: "confirmPassword",
          type: "password",
          label: "Confirm password",
          required: true,
          autocomplete: "new-password",
          placeholder: "••••••••",
          minlength: 8,
          maxlength: 100,
          pattern: '^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&])[A-Za-z\\d@$!%*?&]{8,100}$',
        }) %>

        <button type="submit" class="btn-orange w-full py-4 text-base font-bold shadow-lg shadow-brand-orange/10">
          Sign up
        </button>

      </form>

      <%- include("../../partials/form/footer", {
        text: "Already have an account?",
        href: _flow === "oauth"
          ? `/signin?flow=oauth&request_id=${encodeURIComponent(requestId)}`
          : "/signin",
        linkText: "Sign in"
      }) %>

      <% } %>
    </div>

    <!-- Trust Indicator -->
    <div class="text-center mt-6">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/60 dark:bg-[#151820]/60 backdrop-blur-xs border border-slate-200/40 dark:border-slate-700/25 shadow-xs dark:shadow-black/10">
        <svg class="w-4 h-4 text-green-600 dark:text-emerald-400 animate-pulse" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
        </svg>
        <span class="text-xs font-semibold text-slate-600 dark:text-slate-500">Secure & Encrypted Session</span>
      </div>
    </div>
  </div>
</div>