<% layout("layouts/main") %>

<% const _flow = flow ?? 'default' %>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-12 px-4">
  <div class="w-full max-w-md">
    <div class="bg-white/80 backdrop-blur-lg rounded-3xl shadow-2xl border border-white/60 p-8 sm:p-10">

      <%- include("../../partials/form/header", {
        title: "Reset your password",
        subtitle: "Enter your email address and we'll send you a link to reset your password."
      }) %>

      <%- include("../../partials/alert", { success, error }) %>

      <% if (!success) { %>
      <form method="POST" action="/forgot-password" class="space-y-6">
        <input type="hidden" name="flow" value=<%= _flow %> />
        <% if (_flow === 'oauth') { %>
        <input type="hidden" name="request_id" value="<%= requestId %>" />
        <% } %>
        <%- include("../../partials/form/input", {
            id: "email",
            name: "email",
            type: "email",
            label: "Email address",
            required: true,
            autocomplete: "email",
            placeholder: "you@example.com"
          }) %>

        <button type="submit" class="btn-orange w-full">
          Sign in
        </button>

      </form>
      <% } else { %>
      <div class="pt-2">
        <a href="<%= _flow === 'oauth'
          ? `/forgot-password?flow=oauth&request_id=${encodeURIComponent(requestId)}`
          : '/forgot-password' %>" class="btn-orange w-full">
          Try again
        </a>
      </div>
      <% } %>

      <%- include("../../partials/form/footer", {
        text: "Remember your password?",
        href: _flow === "oauth"
          ? `/signin?flow=oauth&request_id=${encodeURIComponent(requestId)}`
          : "/signin",
        linkText: "Back to sign in"
      }) %>

    </div>

    <!-- Trust Indicator -->
    <div class="text-center mt-6">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/60 backdrop-blur-sm border border-white/60 shadow-sm">
        <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
        </svg>
        <span class="text-sm font-medium text-slate-700">Secure & Encrypted</span>
      </div>
    </div>
  </div>
</div>