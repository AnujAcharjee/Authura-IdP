<% layout("layouts/main") %>

<% const _flow = flow ?? 'default' %>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-12 px-4">
  <div class="w-full max-w-md">
    <!-- Main Card -->
    <div class="bg-white/80 backdrop-blur-lg rounded-3xl shadow-2xl border border-white/60 p-8 sm:p-10">

      <%- include("../../partials/form/header", {
        title: "Reset password",
        // subtitle: "Enter your current and new password to continue."
      }) %>

      <%- include("../../partials/alert", { success, error }) %>

      <form method="POST" action="/reset-password" class="space-y-5">
        <% if (!resetToken) { %>
        <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
          This reset link is missing or invalid. Please request a new one.
          <a href="<%= _flow === 'oauth'
            ? `/forgot-password?flow=oauth&request_id=${encodeURIComponent(requestId)}`
            : '/forgot-password' %>" class="font-semibold text-amber-900 underline underline-offset-2 hover:text-amber-700">
            Back to forgot password
          </a>
          or
          <a href="/account" class="font-semibold text-amber-900 underline underline-offset-2 hover:text-amber-700">
            Back to account
          </a>
        </div>
        <% } %>

        <input type="hidden" name="token" value="<%= resetToken || '' %>">
        <input type="hidden" name="flow" value=<%= _flow %> />
        <% if (_flow === 'oauth') { %>
        <input type="hidden" name="request_id" value="<%= requestId %>" />
        <% } %>

        <%- include("../../partials/form/input", {
          id: "new_password",
          name: "new_password",
          type: "password",
          label: "New password",
          required: true,
          autocomplete: "new-password",
          placeholder: "••••••••",
          minlength: 8,
          maxlength: 100,
          pattern: '^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&])[A-Za-z\\d@$!%*?&]{8,100}$',
          helperText: "Must be at least 8 characters"
        }) %>

        <%- include("../../partials/form/input", {
          id: "confirm_new_password",
          name: "confirm_new_password",
          type: "password",
          label: "Confirm new password",
          required: true,
          autocomplete: "new-password",
          placeholder: "••••••••",
          minlength: 8,
          maxlength: 100,
          pattern: '^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&])[A-Za-z\\d@$!%*?&]{8,100}$',
        }) %>

        <div class="pt-2">
          <%- include("../../partials/form/button", {
            type: "submit",
            text: "Reset password",
            variant: "secondary",
            fullWidth: true,
            size: "lg"
          }) %>
        </div>

      </form>
    </div>

    <!-- Trust Indicator -->
    <div class="text-center mt-6">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/60 backdrop-blur-sm border border-white/60 shadow-sm">
        <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
        </svg>
        <span class="text-sm font-medium text-slate-700">Secure & Encrypted</span>
      </div>
    </div>
  </div>
</div>