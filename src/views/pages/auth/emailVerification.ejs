<% layout("layouts/main") %>

<% 
  const _flow = flow ?? 'default';
%>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 py-12 relative z-10 animate-slideIn">
  <div class="w-full max-w-md">
    <div class="glass-card p-8 sm:p-10 text-center hover:shadow-orange-500/5 hover:border-brand-orange/20 transition-all duration-500">

      <%- include("../../partials/form/header", {
        title: "Verify your email",
        subtitle: `We've sent a verification link to your email. Click the link to activate your account.`
      }) %>

      <!-- Alerts -->
      <%- include("../../partials/alert", { success, error }) %>

      <!-- Resend -->
      <div class="mt-8 space-y-4">
        <p class="text-xs font-semibold text-slate-500">
          Didn't receive the email?
        </p>

        <form method="GET" action="/verify/resend">
          <input type="hidden" name="email" value="<%= typeof email === 'string' ? email : '' %>">
          <input type="hidden" name="flow" value="<%= _flow %>">
          <% if (_flow === 'oauth') { %>
          <input type="hidden" name="request_id" value="<%= requestId %>">
          <% } %>

          <button type="submit" class="btn-orange w-full py-4 text-base font-bold shadow-lg shadow-brand-orange/10">
            Resend verification email
          </button>

        </form>
      </div>

      <!-- Footer -->
      <%- include("../../partials/form/footer", {
        text: "",
        href: _flow === 'oauth'
          ? `/signin?flow=oauth&request_id=${encodeURIComponent(requestId)}`
          : '/signin',
        linkText: "Back to sign in"
      }) %>

    </div>
  </div>
</div>