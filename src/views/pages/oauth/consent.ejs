<% layout('layouts/main') %>

<%
  const _scopes = Array.isArray(scopes) ? scopes : [];
  const appName = clientName.toUpperCase();   
%>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-12 px-4 relative z-10 animate-slideIn">
  <div class="w-full max-w-lg">
    <!-- Main Card -->
    <div class="glass-card overflow-hidden hover:shadow-orange-500/5 hover:border-brand-orange/20 transition-all duration-500">

      <!-- Header -->
      <div class="bg-linear-to-r from-brand-orange to-brand-orangeDark p-8 text-white relative">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-white/10 via-transparent to-transparent pointer-events-none"></div>
        <div class="flex items-center gap-4 relative z-10">
          <div class="w-14 h-14 rounded-2xl bg-white/15 backdrop-blur-md flex items-center justify-center border border-white/20 shadow-md">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <h1 class="text-2xl font-bold tracking-tight truncate"><%= title %></h1>
            <p class="text-white/80 text-xs font-semibold uppercase tracking-wider mt-0.5">Authorization Request</p>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="p-8 space-y-6">

        <div class="text-center mb-4">
          <p class="text-slate-600 font-semibold">
            <span class="text-slate-900 font-extrabold"><%= appName %></span> is requesting access to your account
          </p>
        </div>

        <!-- Client Info -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/60 shadow-xs">
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Client ID</p>
            <p class="text-xs font-mono text-slate-800 break-all select-all"><%= clientId %></p>
          </div>

          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/60 shadow-xs">
            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Requesting Domain</p>
            <p class="text-xs font-bold text-slate-850 truncate select-all"><%= clientDomain %></p>
          </div>
        </div>

        <!-- Requested Scopes -->
        <div class="space-y-3">
          <p class="font-bold text-slate-800 text-sm">
            This application will be able to:
          </p>

          <% if (_scopes.length === 0) { %>
          <div class="p-4 rounded-2xl bg-sky-50 border border-sky-100 shadow-xs">
            <p class="text-xs font-medium text-sky-850">
              No additional permissions requested
            </p>
          </div>
          <% } else { %>
          <div class="space-y-2 max-h-48 overflow-y-auto pr-1">
            <% _scopes.forEach(function (s) { %>
            <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-white border border-slate-200/60 shadow-xs hover-scale">
              <div class="w-2.5 h-2.5 rounded-full bg-brand-orange shadow-md shadow-brand-orange/30"></div>
              <span class="text-xs font-bold text-slate-700 capitalize"><%= s.replace(':', ' ').replace('_', ' ') %></span>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>

        <!-- Warning -->
        <div class="rounded-2xl border border-amber-200 bg-amber-50/50 p-4 shadow-xs">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-bold text-amber-900">Review carefully</p>
              <p class="text-[11px] text-amber-800 leading-normal mt-0.5 font-medium">Make sure you trust this application before granting access. Revealing details may compromise your profile safety.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Actions -->
      <form method="POST" action="/oauth/consent" class="p-6 bg-slate-50/50 border-t border-slate-100">
        <input type="hidden" name="request_id" value="<%= requestId %>" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <%- include('../../partials/form/button', {
            type: 'submit',
            name: 'decision',
            value: 'deny',
            text: 'Deny Access',
            variant: 'outline',
            fullWidth: true,
            size: 'md'
          }) %>

          <%- include('../../partials/form/button', {
            type: 'submit',
            name: 'decision',
            value: 'approve',
            text: 'Allow Access',
            variant: 'primary',
            fullWidth: true,
            size: 'md'
          }) %>
        </div>
      </form>

    </div>
  </div>
</div>
