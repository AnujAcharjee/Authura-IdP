<% layout("layouts/main") %>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 bg-transparent">
  <div class="w-full max-w-lg text-center">

    <!-- Illustration -->
    <div class="flex justify-center mb-8">
      <img src="/images/500 Internal Server.svg" alt="500 Internal Server Error" class="w-64 sm:w-80 h-auto">
    </div>

    <!-- Heading -->
    <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4 tracking-tight">
      Internal Server Error
    </h1>

    <p class="text-lg text-slate-600 mb-8">
      Something went wrong on our side.
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-8 p-4 rounded-xl bg-red-50 border border-red-200 text-left">
      <p class="text-sm text-red-800 wrap-break-words"><%= error %></p>
    </div>
    <% } %>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">

      <a href="/account" class="px-6 py-3 btn-sky">
        Go to Dashboard
      </a>

      <a href="/" class="px-6 py-3 btn-orange">
        Go to Landing
      </a>

    </div>

    <!-- Divider -->
    <div class="mt-12 pt-8 border-t border-slate-200">
      <p class="text-sm text-slate-500">
        If this problem persists, please contact support.
      </p>
    </div>

  </div>
</div>