<% layout("layouts/main") %>

<%
  const confirmText =
    action === 'delete'
      ? 'Delete Application'
      : action === 'activate'
        ? 'Activate Application'
        : 'Deactivate Application';
%>

<div class="max-w-3xl mx-auto py-10 space-y-8">

  <!-- Back -->
  <a href="/client/<%= clientId %>" class="inline-flex items-center text-sm font-medium text-slate-600 hover:text-slate-900 transition">
    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Client Dashboard
  </a>

  <!-- Card -->
  <section class="bg-white rounded-2xl shadow-sm ring-1 ring-slate-200 p-8">

    <!-- Header -->
    <div class="flex items-start gap-4 mb-8">

      <div class="dashboard-icon">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>

      <div>
        <h1 class="text-xl font-semibold text-slate-900">
          <%= action === 'delete'
              ? 'Delete Application'
              : action === 'activate'
                ? 'Activate Application'
                : 'Deactivate Application' %>
        </h1>
        <p class="text-sm text-slate-500 mt-1">
          Please confirm this action.
        </p>
      </div>
    </div>

    <!-- Context Block -->
    <div class="rounded-xl bg-slate-50 border border-slate-200 p-5 mb-8">
      <p class="text-sm font-medium text-slate-900 mb-2">
        Are you sure?
      </p>

      <% if (action === 'delete') { %>
      <p class="text-sm text-slate-600">
        This action is permanent. All client credentials, redirect URIs,
        and secrets will be removed and cannot be recovered.
      </p>
      <% } else if (action === 'activate') { %>
      <p class="text-sm text-slate-600">
        The application will be re-enabled for OAuth authorization and token requests.
      </p>
      <% } else { %>
      <p class="text-sm text-slate-600">
        The application will stop accepting OAuth authorization and token requests.
        It can be reactivated later.
      </p>
      <% } %>
    </div>

    <!-- App Info -->
    <div class="rounded-xl bg-slate-50 border border-slate-200 p-5 mb-8">
      <p class="text-xs uppercase tracking-wide text-slate-500 mb-2">
        Application
      </p>
      <p class="text-sm font-semibold text-slate-900">
        <%= name %>
      </p>
      <p class="text-xs font-mono text-slate-500 mt-1">
        <%= clientId %>
      </p>
    </div>

    <!-- Actions -->
    <div class="flex justify-end gap-3">

      <a href="/client/<%= clientId %>" class="px-4 py-2 text-sm font-medium rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50 transition">
        Cancel
      </a>

      <form method="POST" action="/client/<%= clientId %><%= action === 'delete'
              ? '?_method=DELETE'
              : action === 'activate'
                ? '/activate'
                : '?_method=PUT' %>">

        <button type="submit" class="px-6 py-2.5 text-sm font-medium rounded-lg border transition
            <%= action === 'delete'
                ? 'border-rose-500 text-rose-600 hover:bg-rose-50'
                : action === 'activate'
                  ? 'border-green-500 text-green-600 hover:bg-green-50'
                  : 'border-slate-900 text-slate-900 hover:bg-slate-100'
            %>">
          <%= confirmText %>
        </button>

      </form>

    </div>

  </section>

</div>