<% layout("layouts/main") %>

<%
  const _avatar = user.avatar
    ? user.avatar
    : user.gender === 'MALE'
      ? '/images/avatar-m-placeholder.jpg'
      : '/images/avatar-f-placeholder.png';
%>

<div class="max-w-7xl mx-auto py-6 sm:py-8 space-y-6 sm:space-y-8">

  <!-- Page Header -->
  <div class="gap-2 hidden sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Dashboard</h1>
      <p class="text-slate-600 mt-1">Manage your account and clients</p>
    </div>
  </div>

  <%- include("../../../partials/alert", { success, error }) %>

  <!-- Profile Section -->
  <section class="dashboard-section">
    <div class="flex flex-col sm:flex-row items-start gap-6">
      <!-- Avatar -->
      <div class="relative">
        <img src="<%= _avatar %>" alt="<%= user.name %>" class="h-20 w-20 rounded-2xl object-cover ring-4 ring-orange-500/20" />
        <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-green-500 rounded-full border-4 border-white"></div>
      </div>

      <!-- User Info -->
      <div class="flex-1 min-w-0">

        <!-- Name -->
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 wrap-break-words">
          <%= user.name %>
        </h2>

        <!-- Email + Verified -->
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-slate-600 break-all">
            <%= user.email %>
          </span>

          <% if(user.isEmailVerified) { %>
          <span class="px-1 py-0.5 rounded-2xl bg-green-200/70">
            <svg class="w-4 h-4 text-green-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          </span>
          <% } %>
        </div>

        <!-- Joined Date -->
        <div class="flex items-center gap-2 text-sm text-slate-500 mt-3">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Joined <%= createdAtFormatted %></span>
        </div>

      </div>
    </div>
  </section>

  <!-- Security Section -->
  <section class="dashboard-section">
    <div class="flex items-center gap-3 mb-6">
      <div class="dashboard-icon">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h2 class="text-xl font-bold text-slate-900">Security Settings</h2>
    </div>

    <div class="space-y-4">

      <!-- Password -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between p-4 rounded-xl bg-linear-to-br from-slate-50 to-white border border-slate-200 hover:border-orange-300 transition-colors">
        <div class="flex items-start sm:items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-linear-to-br from-sky-100 to-sky-200 flex items-center justify-center">
            <svg class="w-6 h-6 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <div>
            <p class="font-semibold text-slate-900">Password</p>
            <p class="text-sm text-slate-600">Update your account credentials</p>
          </div>
        </div>

        <% if (success === 'Password reset email sent') { %>
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <!-- Success State -->
          <div class="flex items-center gap-3 px-4 py-2.5 rounded-lg bg-green-50 text-green-700 border border-green-200">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-sm font-medium">
              Reset email sent
            </span>
          </div>

          <!-- Resend -->
          <a href="/account/change-password" class="btn-outline-sky text-xs w-full sm:w-auto sm:text-sm py-1.5 sm:py-2 px-3 sm:px-4">
            Resend
          </a>
        </div>
        <% } else { %>
        <a href="/account/change-password" class="btn-outline-sky text-xs w-full sm:w-auto sm:text-sm py-1.5 sm:py-2 px-3 sm:px-4">
          Reset Password
        </a>
        <% } %>
      </div>

      <!-- MFA -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between p-4 rounded-xl bg-linear-to-br from-slate-50 to-white border border-slate-200 hover:border-orange-300 transition-colors">
        <div class="flex items-start sm:items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-linear-to-br <%= user.mfaEnabled ? 'from-green-100 to-green-200' : 'from-sky-100 to-sky-200' %> <%= user.mfaEnabled ? '' : 'sky' %>-200 flex items-center justify-center">
            <svg class="w-6 h-6 <%= user.mfaEnabled ? 'text-green-600' : 'text-sky-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>

          <div>
            <p class="text-base font-semibold text-slate-900">Two-Factor Authentication</p>

            <% if (user.mfaEnabled) { %>
            <span class="inline-flex items-center px-3 py-1 mt-2 text-xs font-medium rounded-full bg-green-100 text-green-700">
              Enabled
            </span>
            <% } else { %>
            <span class="inline-flex items-center px-3 py-1 mt-2 text-xs font-medium rounded-full bg-slate-100 text-slate-600">
              Not enabled
            </span>
            <% } %>

          </div>
        </div>

        <a href="/account/<%= user.mfaEnabled ? 'mfa-disable' : 'mfa-enable' %>" class="<%= user.mfaEnabled ? 'btn-outline-rose' : 'btn-outline-sky'%> text-xs w-full sm:w-auto sm:text-sm py-1.5 sm:py-2 px-3 sm:px-4">
          <%= user.mfaEnabled ? 'Disable' : 'Enable'%>
        </a>
      </div>
    </div>
  </section>

  <!-- OAuth Consents Section -->
  <section class="dashboard-section">
    <div class="flex items-center gap-3 mb-6">
      <div class="dashboard-icon">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>

      <div>
        <h2 class="text-xl font-bold text-slate-900">OAuth Consents</h2>
        <p class="text-sm text-slate-600 max-w-55 sm:max-w-md">
          Applications you’ve authorized. You can revoke access at any time.
        </p>
      </div>
    </div>

    <% if (oauthConsents.length === 0) { %>
    <div class="text-center py-12 px-4 rounded-xl border-2 border-dashed border-slate-200">
      <svg class="w-12 h-12 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <p class="text-slate-500 font-medium">No OAuth consents yet</p>
      <p class="text-sm text-slate-400 mt-1">Authorized client applications will appear here</p>
    </div>
    <% } else { %>
    <div class="space-y-3">
      <% for (const consent of oauthConsents) { %>
      <div class="p-5 rounded-xl bg-linear-to-br from-slate-50 to-white border border-slate-200 hover:border-orange-300 transition-colors">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="flex-1 space-y-2">
            <div class="flex items-center gap-2">
              <p class="font-semibold text-slate-900"><%= consent.client.domain %></p>
              <%- include("../../../partials/ui/badge", {
                    variant: consent.revokedAt ? "danger" : "info",
                    text: consent.revokedAt ? "Revoked" : "Active",
                    size: "sm"
              }) %>
            </div>
            <div class="flex flex-wrap gap-2">
              <% consent.scopes.forEach(scope => { %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-200 text-slate-700 text-xs font-medium">
                <%= scope %>
              </span>
              <% }) %>
            </div>
            <% if (consent.revokedAt) { %>
            <p class="text-xs text-slate-500">
              Revoked on <%= consent.revokedAt.toLocaleDateString() %>
            </p>
            <% } else { %>
            <p class="text-xs text-slate-500">
              Issued on <%= consent.date.toLocaleDateString() %>
            </p>
            <% } %>
          </div>
          <% if (consent.revokedAt) { %>
          <a href="/account/reissue-consent?clientId=<%= encodeURIComponent(consent.client.id) %>&clientDomain=<%= encodeURIComponent(consent.client.domain) %>" class="btn-outline-sky">
            Reissue
          </a>
          <% } else { %>
          <a href="/account/revoke-consent?clientId=<%= encodeURIComponent(consent.client.id) %>&clientDomain=<%= encodeURIComponent(consent.client.domain) %>" class="btn-outline-gray">
            Revoke
          </a>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>
  </section>

  <!-- Client Section -->
  <section class="dashboard-section">

    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between mb-8">

      <!-- Left Section -->
      <div class="flex items-start gap-3 sm:gap-4">

        <!-- Icon -->
        <div class="dashboard-icon bg-slate-900 p-2 rounded-xl shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
          </svg>
        </div>

        <!-- Text Content -->
        <div class="min-w-0">

          <!-- Title + Badge -->
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-lg sm:text-xl font-bold text-slate-900">
              Registered Clients
            </h2>

            <%- include("../../../partials/ui/badge", {
              variant: "warning",
              text: "Developer Section",
              size: "sm"
        }) %>
          </div>

          <!-- Description -->
          <p class="text-sm text-slate-600 mt-2 max-w-md">
            Client applications you’ve registered that use Pramaan for authentication.
          </p>
        </div>
      </div>

      <!-- Right: Action Button -->
      <% if (clients.length !== 0) { %>
      <a href="/create-client" class="btn-orange py-3 w-full sm:w-auto text-center">
        <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Create OAuth Client
      </a>
      <% } %>

    </div>

    <% if (clients.length === 0) { %>
    <div class="text-center py-16 px-4 rounded-xl border-2 border-dashed border-slate-200">
      <div class="w-16 h-16 rounded-full bg-brand-orangeDark flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-orange-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
      </div>
      <p class="text-slate-700 font-semibold mb-1">No clients yet</p>
      <p class="text-sm text-slate-500 mb-6">Create your first OAuth client to get started</p>
      <a href="/create-client" class="btn-orange">
        Create Client
      </a>
    </div>
    <% } else { %>
    <div class="space-y-3">
      <% for (const client of clients) { %>
      <div class="group p-5 rounded-xl bg-linear-to-br from-slate-50 to-white border border-slate-200 hover:border-orange-300 hover:shadow-md transition-all">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="flex-1 space-y-3">
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="font-bold text-slate-900 text-lg"><%= client.name %></h3>
              <%- include("../../../partials/ui/badge", {
                    variant: client.isActive ? "success" : "default",
                    text: client.isActive ? "Active" : "Inactive",
                    size: "sm"
                  }) %>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
              <span class="text-sm font-medium text-slate-600">Client ID:</span>
              <div class="flex items-center gap-2 flex-1 min-w-0">
                <code class="text-xs font-mono text-slate-700 bg-slate-100 px-3 py-1.5 rounded-lg flex-1 truncate">
                  <%= client.id %>
                </code>
                <button type="button" class="copy-btn p-2 hover:bg-slate-200 rounded-lg transition-colors group/btn" data-copy-text="<%= client.id %>" title="Copy Client ID">
                  <span class="copy-btn-label text-xs font-medium text-slate-600 group-hover/btn:text-slate-900">Copy</span>
                </button>
              </div>
            </div>
          </div>

          <a href="/client/<%= client.id %>" class="inline-flex items-center gap-1 px-4 py-2 rounded-lg bg-white border border-slate-300 text-slate-700 font-medium hover:border-sky-500 hover:text-sky-600 transition-colors opacity-100 sm:opacity-0 sm:group-hover:opacity-100">
            View Details
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>
  </section>

  <!-- Danger Zone -->
  <section class="dashboard-danger-section">
    <div class="flex items-center gap-3 mb-4">
      <div class="dashboard-icon">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div>
        <h2 class="text-xl font-bold text-slate-900">Danger Zone</h2>
        <p class="text-sm text-slate-600">Irreversible actions</p>
      </div>
    </div>

    <div class="space-y-4">
      <form method="POST" action="/signout" class="group">
        <button type="submit" class="w-full text-left cursor-pointer">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 p-4 rounded-xl bg-white/80 border border-slate-200 hover:border-slate-300 transition">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-900">Sign out from all devices</p>
                <p class="text-xs text-slate-500 mt-1">Ends all active sessions linked to your account.</p>
              </div>
            </div>
          </div>
        </button>
      </form>

      <a href="/account/delete" class="block">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 p-4 rounded-xl bg-white/80 border border-rose-200 hover:border-rose-300 transition">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4h6v3m-9 0h12" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-slate-900">Delete account</p>
              <p class="text-xs text-slate-500 mt-1">Permanently remove your account and all data.</p>
            </div>
          </div>
        </div>
      </a>
    </div>
  </section>

</div>

<script src="/js/copyBtn.js" defer></script>