<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Test App</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #1e293b, #0f172a);
      color: white;
    }

    .card {
      background: #1e293b;
      padding: 3rem;
      border-radius: 16px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      text-align: center;
      width: 100%;
      max-width: 400px;
    }

    h1 {
      margin-bottom: 1rem;
      font-size: 1.8rem;
    }

    p {
      margin-bottom: 2rem;
      color: #94a3b8;
      font-size: 0.95rem;
    }

    .btn {
      display: block;
      width: 100%;
      padding: 0.8rem;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 600;
      margin-bottom: 1rem;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: #3b82f6;
      color: white;
    }

    .btn-primary:hover {
      background: #2563eb;
      transform: translateY(-2px);
    }

    .btn-secondary {
      background: #334155;
      color: white;
    }

    .btn-secondary:hover {
      background: #475569;
      transform: translateY(-2px);
    }

    footer {
      margin-top: 1.5rem;
      font-size: 0.75rem;
      color: #64748b;
    }
  </style>
</head>

<body>
  <div class="card">
    <h1>Test App</h1>

    <a class="btn btn-primary" href="/login">Sign In with Pramaan</a>

    <footer>
      Powered by Pramaan Identity Provider
    </footer>
  </div>
</body>
</html>