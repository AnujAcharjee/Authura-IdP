<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login Success</title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>
</head>

<body class="min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center p-4 relative overflow-hidden font-sans">
  
  <!-- Decorative background elements -->
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Main Card -->
  <div class="w-full max-w-lg bg-slate-900/60 backdrop-blur-xl border border-slate-800 rounded-3xl p-8 sm:p-10 shadow-2xl text-center relative z-10 transition-all duration-300 hover:border-slate-700/80">
    
    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      Authenticated via Pramaan
    </div>

    <div class="flex flex-col items-center mb-6">
      <% if (user.avatar) { %>
      <img src="<%= user.avatar %>" alt="User Avatar" class="w-20 h-20 rounded-2xl object-cover border-2 border-sky-500/30 ring-4 ring-sky-500/10 mb-4 shadow-lg hover-scale" />
      <% } else { %>
      <div class="w-20 h-20 rounded-2xl bg-sky-550/10 border border-sky-500/20 text-sky-400 flex items-center justify-center mb-4 shadow-lg">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
      <% } %>

      <h1 class="text-xl sm:text-2xl font-extrabold text-slate-100 tracking-tight">Welcome, <%= user.name || 'User' %></h1>
      <div class="text-sm font-semibold text-slate-400 mt-1 select-all"><%= user.email %></div>
    </div>

    <!-- Metadata Details Table -->
    <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-5 text-left text-xs space-y-3 mb-8 shadow-inner">
      <div class="flex justify-between items-center py-1.5 border-b border-slate-900 gap-4">
        <span class="font-bold text-slate-500 uppercase tracking-wide">User ID</span>
        <span class="font-mono text-slate-300 truncate select-all" title="<%= user.id %>"><%= user.id %></span>
      </div>
      <div class="flex justify-between items-center py-1.5 border-b border-slate-900 gap-4">
        <span class="font-bold text-slate-500 uppercase tracking-wide">Provider</span>
        <span class="font-semibold text-sky-400"><%= user.provider %></span>
      </div>
      <div class="flex justify-between items-center py-1.5 border-b border-slate-900 gap-4">
        <span class="font-bold text-slate-500 uppercase tracking-wide">Provider User ID</span>
        <span class="font-mono text-slate-300 truncate select-all" title="<%= user.providerUserId %>"><%= user.providerUserId %></span>
      </div>
      <div class="flex justify-between items-center py-1.5 gap-4">
        <span class="font-bold text-slate-500 uppercase tracking-wide">Created</span>
        <span class="font-semibold text-slate-305"><%= user.createdAt %></span>
      </div>
    </div>

    <form method="POST" action="/logout">
      <button type="submit" class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-linear-to-r from-red-500 to-red-650 text-white font-bold text-sm shadow-lg shadow-red-500/10 hover:shadow-xl hover:shadow-red-500/20 active:scale-[0.98] hover:-translate-y-0.5 transition-all duration-300 cursor-pointer">
        Logout
      </button>
    </form>

  </div>
</body>
</html>